<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GeoAdminWinUI.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GeoAdminWinUI"
    Loaded="Page_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="媒体内容" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="同步第三方媒体并管理发布状态"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click" />
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="0,12,0,8"
                 Severity="Success" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2" Margin="0,0,0,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" PlaceholderText="搜索媒体名称" KeyDown="SearchBox_KeyDown" />

            <ComboBox x:Name="TypeBox" Grid.Column="1" Width="130" SelectedIndex="0">
                <ComboBoxItem Content="全部类型" Tag="" />
                <ComboBoxItem Content="新闻媒体" Tag="新闻媒体" />
                <ComboBoxItem Content="自媒体" Tag="自媒体" />
                <ComboBoxItem Content="微信公众号" Tag="微信公众号" />
                <ComboBoxItem Content="微博" Tag="微博" />
                <ComboBoxItem Content="短视频" Tag="短视频" />
                <ComboBoxItem Content="小红书" Tag="小红书" />
            </ComboBox>

            <ComboBox x:Name="StatusBox" Grid.Column="2" Width="110" SelectedIndex="0">
                <ComboBoxItem Content="全部状态" Tag="" />
                <ComboBoxItem Content="草稿" Tag="draft" />
                <ComboBoxItem Content="已发布" Tag="published" />
                <ComboBoxItem Content="已下架" Tag="offline" />
            </ComboBox>

            <Button Grid.Column="3" Content="查询" Click="Query_Click" />
            <Button Grid.Column="4" Content="同步媒体" Click="Sync_Click" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="CountText" Grid.Column="6" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView Grid.Row="3" x:Name="MediaList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MediaItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,7">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind MediaType}" FontSize="11" Foreground="#3D8CE6" />
                                    <TextBlock Text="{x:Bind StatusText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind MetaText}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock Text="{x:Bind PriceText}" FontSize="12" />
                                    <TextBlock Text="更新 " FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind UpdatedText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{x:Bind ActionText}" Tag="{x:Bind Id}"
                                    Click="MediaAction_Click" Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
