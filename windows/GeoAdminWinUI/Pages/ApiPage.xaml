<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GeoAdminWinUI.ApiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GeoAdminWinUI"
    Loaded="Page_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="API 接入" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="查看第三方 API 接入配置（Windows 版为只读）"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click" />
        </Grid>

        <InfoBar Grid.Row="1" Margin="0,12,0,8"
                 Severity="Informational"
                 IsOpen="True"
                 IsClosable="False"
                 Title="只读模式"
                 Message="Windows 版不提供新增、编辑、删除、启停、发布和接入测试；请在 macOS 管理端修改。" />

        <Grid Grid.Row="3" Margin="0,0,0,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索名称、code 或路径"
                     KeyDown="SearchBox_KeyDown" />
            <Button Grid.Column="1" Content="查询" Click="Search_Click" />
            <TextBlock x:Name="CountText" Grid.Column="2" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <InfoBar x:Name="ErrorBar" Grid.Row="2" Title="加载失败" Severity="Error" IsOpen="False"
                 Margin="0,0,0,8" />

        <ListView Grid.Row="4" x:Name="ApiList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ApiDefinition">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#143D8CE6" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind Method}" FontFamily="Consolas"
                                               FontWeight="SemiBold" Foreground="#3D8CE6" />
                                </Border>
                                <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Code}" FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind StatusText}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind TokenText}" FontSize="11" Foreground="#D97706" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind LocalPath}" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Text="{x:Bind Upstream}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind MetaText}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
