<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GeoAdminWinUI.LocalApiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GeoAdminWinUI"
    Loaded="Page_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="本程序 API" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="geoEngine 自身暴露的全部接口，支持按分组导出"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="导出" Click="Export_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="0,12,0,8"
                 Severity="Success" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2" Margin="0,0,0,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="GroupBox" SelectedIndex="0" SelectionChanged="GroupBox_SelectionChanged" />
            <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView Grid.Row="3" x:Name="LocalApiList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LocalApiItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,6">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#143D8CE6" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind Method}" FontFamily="Consolas"
                                               FontWeight="SemiBold" Foreground="#3D8CE6" />
                                </Border>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{x:Bind Group}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind StatusText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind TokenText}" FontSize="11" Foreground="#D97706" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Path}" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Text="{x:Bind Auth}" FontSize="11" Foreground="#3D8CE6" />
                            <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
