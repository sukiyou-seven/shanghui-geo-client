<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GeoAdminWinUI.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="18">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="概览" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="接入、媒体、任务池与转发运行状态"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click" />
            </Grid>

            <InfoBar x:Name="ErrorBar" Title="加载失败" Severity="Error" IsOpen="False" />
            <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Left" Width="24" Height="24" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ApiCountText" Text="—" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="接入 API" FontWeight="SemiBold" />
                        <TextBlock x:Name="ApiSubText" Text="" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="MediaCountText" Text="—" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="媒体资源" FontWeight="SemiBold" />
                        <TextBlock x:Name="MediaSubText" Text="" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RequestCountText" Text="—" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="24h 请求" FontWeight="SemiBold" />
                        <TextBlock x:Name="RequestSubText" Text="" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TaskPendingText" Text="—" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="任务池待执行" FontWeight="SemiBold" />
                        <TextBlock x:Name="TaskSubText" Text="" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="服务状态" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ServiceText" Text="—" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock x:Name="SyncText" Text="—" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
